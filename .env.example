# Copy to .env and fill in. Without a key the assistant runs on its
# deterministic rule fallback, so the app still works.

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash.
#
# Measured live (2026-07): gemini-3.5-flash intermittently returns 503 "high
# demand" and can take 30s+ under load; gemini-3.1-flash-lite answered the same
# grounded prompts quickly and correctly, so it is the pragmatic choice while
# 3.5 is busy. gemini-2.5-flash returns 404 for newly created API keys.
GEMINI_MODEL=gemini-3.1-flash-lite
